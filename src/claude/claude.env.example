# Site-specific configuration for Claude Code.
#
#     cp /usr/local/share/claude-devcontainer/claude.env.example \
#        .devcontainer/claude.env
#
# Fill it in, add .devcontainer/claude.env to your .gitignore, and open a new
# terminal - your shell sources it on start, and the firewall reads it when the
# container starts.
#
# Every value below is a placeholder. The endpoint and model names your site
# uses will be different, and asking for a model you do not have access to
# fails at request time. If you use api.anthropic.com, you only need
# ANTHROPIC_API_KEY.

# Credentials. ANTHROPIC_AUTH_TOKEN is sent as "Authorization: Bearer <token>"
# and is what most gateways expect. ANTHROPIC_API_KEY is sent as "X-Api-Key"
# and is what api.anthropic.com expects. Set one, not both.
export ANTHROPIC_AUTH_TOKEN="replace-with-your-token"
# export ANTHROPIC_API_KEY="replace-with-your-key"

# API endpoint. Comment out to talk to api.anthropic.com directly.
export ANTHROPIC_BASE_URL="https://api.example.org"

# Model ids as your endpoint names them. ANTHROPIC_MODEL is the main session
# model; the DEFAULT_* variables are what the opus/sonnet/haiku aliases and
# /model resolve to. Haiku is also used for background tasks.
export ANTHROPIC_MODEL="example-claude-opus-5"
export ANTHROPIC_DEFAULT_OPUS_MODEL="example-claude-opus-5"
export ANTHROPIC_DEFAULT_SONNET_MODEL="example-claude-sonnet-5"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="example-claude-haiku-4-5"

# Model used for subagents. Comment out to inherit the session model.
export CLAUDE_CODE_SUBAGENT_MODEL="example-claude-opus-5"

# Gateway compatibility. Drop the attribution block from the system prompt so
# gateways that cache on the request body still get cache hits, and strip
# anthropic-beta headers and beta tool-schema fields that some gateways reject.
# Neither is needed against api.anthropic.com, and disabling betas also turns
# off MCP tool search, so leave both commented out unless you need them.
export CLAUDE_CODE_ATTRIBUTION_HEADER="0"
export CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS="1"

# Disable auto-updates, telemetry, error reporting, and release notes. This
# variable only checks whether it is set, so "0" still turns it ON - comment
# the line out to turn it off.
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC="1"

# Space separated hosts the container firewall may reach, in addition to
# GitHub. Must include the host from ANTHROPIC_BASE_URL, or requests are
# rejected before they leave the container. Defaults to api.anthropic.com.
export ALLOWED_DOMAINS="api.example.org"
